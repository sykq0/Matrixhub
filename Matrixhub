--// MatrixUI v0.1
--// UI library - Window / Tabs / Toggle / Button / Slider / Dropdown

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer

local MatrixUI = {}

MatrixUI.Theme = {
    Background = Color3.fromRGB(20, 29, 41),
    Panel = Color3.fromRGB(26, 38, 52),
    PanelHover = Color3.fromRGB(31, 45, 61),
    Accent = Color3.fromRGB(0, 125, 230),
    Text = Color3.fromRGB(235, 238, 242),
    SubText = Color3.fromRGB(170, 180, 190),
    ToggleOff = Color3.fromRGB(5, 14, 25),
    ToggleOn = Color3.fromRGB(0, 125, 230),
}

local function Tween(object, properties, duration)
    TweenService:Create(
        object,
        TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        properties
    ):Play()
end

local function Corner(object, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 4)
    corner.Parent = object
    return corner
end

local function Padding(object, left, right, top, bottom)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, left or 0)
    p.PaddingRight = UDim.new(0, right or 0)
    p.PaddingTop = UDim.new(0, top or 0)
    p.PaddingBottom = UDim.new(0, bottom or 0)
    p.Parent = object
    return p
end

function MatrixUI:CreateWindow(options)
    options = options or {}

    local Window = {}
    Window.Tabs = {}

    local Gui = Instance.new("ScreenGui")
    Gui.Name = "MatrixUI"
    Gui.ResetOnSpawn = false
    Gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    Gui.Parent = Player:WaitForChild("PlayerGui")

    local Main = Instance.new("Frame")
    Main.Name = "Window"
    Main.Size = options.Size or UDim2.fromOffset(550, 400)
    Main.Position = UDim2.fromScale(0.5, 0.5)
    Main.AnchorPoint = Vector2.new(0.5, 0.5)
    Main.BackgroundColor3 = MatrixUI.Theme.Background
    Main.BorderSizePixel = 0
    Main.Parent = Gui

    Corner(Main, 4)

    --// Header
    local Header = Instance.new("Frame")
    Header.Name = "Header"
    Header.Size = UDim2.new(1, 0, 0, 72)
    Header.BackgroundTransparency = 1
    Header.Parent = Main

    local Title = Instance.new("TextLabel")
    Title.Name = "Title"
    Title.BackgroundTransparency = 1
    Title.Position = UDim2.fromOffset(22, 12)
    Title.Size = UDim2.new(0, 350, 0, 42)
    Title.Font = Enum.Font.GothamMedium
    Title.Text = options.Title or "MatrixUI"
    Title.TextColor3 = MatrixUI.Theme.Accent
    Title.TextSize = 28
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Header

    local Discord = Instance.new("TextButton")
    Discord.Name = "Discord"
    Discord.BackgroundTransparency = 1
    Discord.Position = UDim2.new(1, -95, 0, 15)
    Discord.Size = UDim2.fromOffset(35, 35)
    Discord.Text = "●"
    Discord.Font = Enum.Font.GothamBold
    Discord.TextSize = 22
    Discord.TextColor3 = MatrixUI.Theme.Text
    Discord.Parent = Header

    local Settings = Instance.new("TextButton")
    Settings.Name = "Settings"
    Settings.BackgroundTransparency = 1
    Settings.Position = UDim2.new(1, -50, 0, 15)
    Settings.Size = UDim2.fromOffset(35, 35)
    Settings.Text = "⚙"
    Settings.Font = Enum.Font.GothamBold
    Settings.TextSize = 24
    Settings.TextColor3 = MatrixUI.Theme.Text
    Settings.Parent = Header

    --// Tabs
    local TabBar = Instance.new("Frame")
    TabBar.Name = "TabBar"
    TabBar.Position = UDim2.fromOffset(8, 72)
    TabBar.Size = UDim2.new(1, -16, 0, 60)
    TabBar.BackgroundTransparency = 1
    TabBar.Parent = Main

    local TabLayout = Instance.new("UIListLayout")
    TabLayout.FillDirection = Enum.FillDirection.Horizontal
    TabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    TabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    TabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabLayout.Padding = UDim.new(0, 5)
    TabLayout.Parent = TabBar

    --// Content
    local Content = Instance.new("Frame")
    Content.Name = "Content"
    Content.Position = UDim2.fromOffset(8, 132)
    Content.Size = UDim2.new(1, -16, 1, -140)
    Content.BackgroundTransparency = 1
    Content.Parent = Main

    --// Dragging
    local dragging = false
    local dragStart
    local startPosition

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = Main.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - dragStart

            Main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    function Window:CreateTab(name)
        local Tab = {}
        Tab.Name = name

        local Button = Instance.new("TextButton")
        Button.Name = name
        Button.BackgroundTransparency = 1
        Button.Size = UDim2.fromOffset(145, 55)
        Button.Text = name
        Button.Font = Enum.Font.GothamBold
        Button.TextSize = 15
        Button.TextColor3 = MatrixUI.Theme.Text
        Button.AutoButtonColor = false
        Button.Parent = TabBar

        local Indicator = Instance.new("Frame")
        Indicator.BackgroundColor3 = MatrixUI.Theme.Accent
        Indicator.BorderSizePixel = 0
        Indicator.Position = UDim2.new(0, 0, 1, -3)
        Indicator.Size = UDim2.new(1, 0, 0, 3)
        Indicator.Visible = false
        Indicator.Parent = Button

        local Page = Instance.new("ScrollingFrame")
        Page.Name = name .. "_Page"
        Page.Size = UDim2.fromScale(1, 1)
        Page.BackgroundTransparency = 1
        Page.BorderSizePixel = 0
        Page.ScrollBarThickness = 5
        Page.ScrollBarImageColor3 = MatrixUI.Theme.Accent
        Page.Visible = false
        Page.CanvasSize = UDim2.new()
        Page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        Page.Parent = Content

        local Columns = Instance.new("Frame")
        Columns.BackgroundTransparency = 1
        Columns.Size = UDim2.new(1, -10, 1, 0)
        Columns.Parent = Page

        local Left = Instance.new("Frame")
        Left.Name = "Left"
        Left.Size = UDim2.new(0.5, -5, 1, 0)
        Left.BackgroundTransparency = 1
        Left.Parent = Columns

        local Right = Instance.new("Frame")
        Right.Name = "Right"
        Right.Position = UDim2.new(0.5, 5, 0, 0)
        Right.Size = UDim2.new(0.5, -5, 1, 0)
        Right.BackgroundTransparency = 1
        Right.Parent = Columns

        local leftLayout = Instance.new("UIListLayout")
        leftLayout.Padding = UDim.new(0, 6)
        leftLayout.Parent = Left

        local rightLayout = Instance.new("UIListLayout")
        rightLayout.Padding = UDim.new(0, 6)
        rightLayout.Parent = Right

        Tab.Page = Page
        Tab.Left = Left
        Tab.Right = Right

        function Tab:_Container(side)
            return side == "Right" and Right or Left
        end

        function Tab:CreateToggle(data)
            local container = self:_Container(data.Side)

            local Row = Instance.new("Frame")
            Row.Size = UDim2.new(1, 0, 0, 48)
            Row.BackgroundColor3 = MatrixUI.Theme.Panel
            Row.BorderSizePixel = 0
            Row.Parent = container

            Corner(Row, 3)
            Padding(Row, 14, 10)

            local Label = Instance.new("TextLabel")
            Label.BackgroundTransparency = 1
            Label.Size = UDim2.new(1, -75, 1, 0)
            Label.Font = Enum.Font.GothamBold
            Label.Text = data.Name or "Toggle"
            Label.TextSize = 14
            Label.TextColor3 = MatrixUI.Theme.Text
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Row

            local Toggle = Instance.new("TextButton")
            Toggle.Size = UDim2.fromOffset(70, 30)
            Toggle.Position = UDim2.new(1, -70, 0.5, -15)
            Toggle.BackgroundColor3 = MatrixUI.Theme.ToggleOff
            Toggle.Text = ""
            Toggle.AutoButtonColor = false
            Toggle.Parent = Row

            Corner(Toggle, 15)

            local Knob = Instance.new("Frame")
            Knob.Size = UDim2.fromOffset(28, 28)
            Knob.Position = UDim2.fromOffset(1, 1)
            Knob.BackgroundColor3 = Color3.fromRGB(190, 190, 190)
            Knob.Parent = Toggle

            Corner(Knob, 14)

            local state = data.Default == true

            local function Update(value)
                state = value

                if state then
                    Tween(Toggle, {
                        BackgroundColor3 = MatrixUI.Theme.ToggleOn
                    })

                    Tween(Knob, {
                        Position = UDim2.new(1, -29, 0, 1),
                        BackgroundColor3 = Color3.fromRGB(235, 235, 235)
                    })
                else
                    Tween(Toggle, {
                        BackgroundColor3 = MatrixUI.Theme.ToggleOff
                    })

                    Tween(Knob, {
                        Position = UDim2.fromOffset(1, 1),
                        BackgroundColor3 = Color3.fromRGB(190, 190, 190)
                    })
                end

                if data.Callback then
                    data.Callback(state)
                end
            end

            Toggle.MouseButton1Click:Connect(function()
                Update(not state)
            end)

            Update(state)

            return {
                Set = Update,
                Get = function()
                    return state
                end
            }
        end

        function Tab:CreateButton(data)
            local container = self:_Container(data.Side)

            local ButtonRow = Instance.new("TextButton")
            ButtonRow.Size = UDim2.new(1, 0, 0, 48)
            ButtonRow.BackgroundColor3 = MatrixUI.Theme.Panel
            ButtonRow.BorderSizePixel = 0
            ButtonRow.Text = data.Name or "Button"
            ButtonRow.Font = Enum.Font.GothamBold
            ButtonRow.TextSize = 14
            ButtonRow.TextColor3 = MatrixUI.Theme.Text
            ButtonRow.AutoButtonColor = false
            ButtonRow.Parent = container

            Corner(ButtonRow, 3)

            ButtonRow.MouseEnter:Connect(function()
                Tween(ButtonRow, {
                    BackgroundColor3 = MatrixUI.Theme.PanelHover
                })
            end)

            ButtonRow.MouseLeave:Connect(function()
                Tween(ButtonRow, {
                    BackgroundColor3 = MatrixUI.Theme.Panel
                })
            end)

            ButtonRow.MouseButton1Click:Connect(function()
                if data.Callback then
                    data.Callback()
                end
            end)

            return ButtonRow
        end

        function Tab:CreateSlider(data)
            local container = self:_Container(data.Side)

            local Row = Instance.new("Frame")
            Row.Size = UDim2.new(1, 0, 0, 72)
            Row.BackgroundColor3 = MatrixUI.Theme.Panel
            Row.BorderSizePixel = 0
            Row.Parent = container

            Corner(Row, 3)

            local Name = Instance.new("TextLabel")
            Name.BackgroundTransparency = 1
            Name.Position = UDim2.fromOffset(14, 8)
            Name.Size = UDim2.new(0.6, 0, 0, 22)
            Name.Font = Enum.Font.GothamBold
            Name.Text = data.Name or "Slider"
            Name.TextSize = 14
            Name.TextColor3 = MatrixUI.Theme.Text
            Name.TextXAlignment = Enum.TextXAlignment.Left
            Name.Parent = Row

            local Value = Instance.new("TextLabel")
            Value.BackgroundTransparency = 1
            Value.Position = UDim2.new(0.65, 0, 0, 8)
            Value.Size = UDim2.new(0.3, 0, 0, 22)
            Value.Font = Enum.Font.GothamBold
            Value.TextSize = 14
            Value.TextColor3 = MatrixUI.Theme.Text
            Value.TextXAlignment = Enum.TextXAlignment.Right
            Value.Parent = Row

            local Bar = Instance.new("Frame")
            Bar.Position = UDim2.fromOffset(14, 45)
            Bar.Size = UDim2.new(1, -28, 0, 8)
            Bar.BackgroundColor3 = MatrixUI.Theme.ToggleOff
            Bar.BorderSizePixel = 0
            Bar.Parent = Row

            Corner(Bar, 4)

            local Fill = Instance.new("Frame")
            Fill.Size = UDim2.fromScale(0, 1)
            Fill.BackgroundColor3 = MatrixUI.Theme.Accent
            Fill.BorderSizePixel = 0
            Fill.Parent = Bar

            Corner(Fill, 4)

            local min = data.Min or 0
            local max = data.Max or 100
            local current = data.Default or min

            local function Set(value)
                current = math.clamp(value, min, max)

                local percent = (current - min) / (max - min)

                Fill.Size = UDim2.new(percent, 0, 1, 0)
                Value.Text = tostring(math.floor(current * 100) / 100)

                if data.Callback then
                    data.Callback(current)
                end
            end

            local function UpdateFromInput(input)
                local percent = math.clamp(
                    (input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X,
                    0,
                    1
                )

                Set(min + ((max - min) * percent))
            end

            Bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then

                    UpdateFromInput(input)

                    local connection
                    connection = UserInputService.InputChanged:Connect(function(changed)
                        if changed.UserInputType == Enum.UserInputType.MouseMovement
                            or changed.UserInputType == Enum.UserInputType.Touch then
                            UpdateFromInput(changed)
                        end
                    end)

                    UserInputService.InputEnded:Connect(function(ended)
                        if ended.UserInputType == input.UserInputType then
                            if connection then
                                connection:Disconnect()
                            end
                        end
                    end)
                end
            end)

            Set(current)

            return {
                Set = Set,
                Get = function()
                    return current
                end
            }
        end

        function Tab:CreateDropdown(data)
            local container = self:_Container(data.Side)

            local Row = Instance.new("TextButton")
            Row.Size = UDim2.new(1, 0, 0, 48)
            Row.BackgroundColor3 = MatrixUI.Theme.Panel
            Row.BorderSizePixel = 0
            Row.Text = ""
            Row.AutoButtonColor = false
            Row.Parent = container

            Corner(Row, 3)

            local Label = Instance.new("TextLabel")
            Label.BackgroundTransparency = 1
            Label.Position = UDim2.fromOffset(14, 0)
            Label.Size = UDim2.new(0.5, 0, 1, 0)
            Label.Font = Enum.Font.GothamBold
            Label.Text = data.Name or "Dropdown"
            Label.TextSize = 14
            Label.TextColor3 = MatrixUI.Theme.Text
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = Row

            local Current = Instance.new("TextLabel")
            Current.BackgroundTransparency = 1
            Current.Position = UDim2.new(0.5, 0, 0, 0)
            Current.Size = UDim2.new(0.45, 0, 1, 0)
            Current.Font = Enum.Font.Gotham
            Current.Text = tostring(data.Default or "Select")
            Current.TextSize = 13
            Current.TextColor3 = MatrixUI.Theme.SubText
            Current.TextXAlignment = Enum.TextXAlignment.Right
            Current.Parent = Row

            local opened = false
            local options = data.Options or {}

            local List = Instance.new("Frame")
            List.Position = UDim2.new(0, 0, 1, 3)
            List.Size = UDim2.new(1, 0, 0, 0)
            List.BackgroundColor3 = MatrixUI.Theme.Panel
            List.BorderSizePixel = 0
            List.Visible = false
            List.ZIndex = 10
            List.Parent = Row

            Corner(List, 3)

            local layout = Instance.new("UIListLayout")
            layout.Parent = List

            local function Open()
                opened = not opened
                List.Visible = opened

                if opened then
                    List.Size = UDim2.new(1, 0, 0, #options * 36)
                else
                    List.Size = UDim2.new(1, 0, 0, 0)
                end
            end

            for _, option in ipairs(options) do
                local Option = Instance.new("TextButton")
                Option.Size = UDim2.new(1, 0, 0, 36)
                Option.BackgroundTransparency = 1
                Option.Text = tostring(option)
                Option.Font = Enum.Font.Gotham
                Option.TextSize = 13
                Option.TextColor3 = MatrixUI.Theme.Text
                Option.ZIndex = 11
                Option.Parent = List

                Option.MouseButton1Click:Connect(function()
                    Current.Text = tostring(option)
                    opened = false
                    List.Visible = false
                    List.Size = UDim2.new(1, 0, 0, 0)

                    if data.Callback then
                        data.Callback(option)
                    end
                end)
            end

            Row.MouseButton1Click:Connect(Open)

            return Row
        end

        Button.MouseButton1Click:Connect(function()
            for _, other in pairs(Window.Tabs) do
                other.Page.Visible = false
                other.Indicator.Visible = false
            end

            Page.Visible = true
            Indicator.Visible = true
        end)

        table.insert(Window.Tabs, {
            Page = Page,
            Indicator = Indicator,
            Object = Tab
        })

        if #Window.Tabs == 1 then
            Page.Visible = true
            Indicator.Visible = true
        end

        return Tab
    end

    return Window
end

return MatrixUI
